# Copiază în .env.local și completează. .env.local e în .gitignore.
# Cheia e folosită doar pe server (app/api/analiza-document), niciodată în browser.
ANTHROPIC_API_KEY=

# Supabase (Project Settings → API Keys). Vezi docs/supabase.md.
# Merg și numele vechi: NEXT_PUBLIC_SUPABASE_ANON_KEY și SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=
# „Publishable key” (sb_publishable_...): doar citire, poate ajunge în browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# „Secret key” (sb_secret_...): scrie în baza de date; doar în scripturi și pe server, fără NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Stripe (docs/adr/0002-abonament-stripe.md). Doar pe server, niciodată în browser.
# De preferat o cheie restricționată (rk_test_…) cu drepturi pe Checkout Sessions, Subscriptions,
# Customer Portal și Prices; merge și sk_test_…. În modul test nu se încasează bani reali.
STRIPE_SECRET_KEY=
# Secretul webhook-ului: din Dashboard (Developers → Webhooks) sau din `stripe listen` local.
STRIPE_WEBHOOK_SECRET=
# Opțional: prețul de 15 lei/lună creat în Dashboard, cu TVA inclus (tax_behavior inclusive), pe un produs
# cu codul fiscal txcd_10701401, cerut de Managed Payments. Fără el, prețul se descrie la crearea plății.
STRIPE_PRICE_ID=

# Conectarea cu Google, pentru Pro (auth.ts, Auth.js v5). Doar pe server.
# AUTH_SECRET: un șir aleator (`npx auth secret` îl generează).
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application), cu redirect URI http://localhost:3000/api/auth/callback/google (și domeniul de pe Vercel).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
