# Copiază în .env.local și completează. .env.local e în .gitignore.
# Cheia e folosită doar pe server (app/api/analiza-document), niciodată în browser.
ANTHROPIC_API_KEY=

# Supabase (Project Settings → API Keys). Vezi docs/supabase.md.
# Merg și numele vechi: NEXT_PUBLIC_SUPABASE_ANON_KEY și SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=
# „Publishable key” (sb_publishable_...): doar citire, poate ajunge în browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# „Secret key” (sb_secret_...): scrie în baza de date; doar în scripturi și pe server, fără NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
